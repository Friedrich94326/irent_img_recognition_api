# Copy to .env and adjust. All variables are optional; defaults shown.

# --- App -------------------------------------------------------------------
IRENT_APP_NAME=iRent Car Damage Evaluation API
IRENT_VERSION=0.1.0

# --- Model / inference ---------------------------------------------------
# Path to a YOLOv8 .pt file. Leave unset to run with the built-in mock detector.
# IRENT_YOLO_WEIGHTS_PATH=./weights/car_damage.pt
IRENT_YOLO_CONFIDENCE_THRESHOLD=0.25
IRENT_YOLO_IOU_THRESHOLD=0.45
IRENT_YOLO_DEVICE=cpu

# --- License plate OCR -------------------------------------------------
# IRENT_PLATE_USE_MOCK=true
# EasyOCR device (cpu / cuda). Unset = follow IRENT_YOLO_DEVICE.
# IRENT_PLATE_DEVICE=cuda
IRENT_PLATE_USE_OPENCV_LOCATOR=true
IRENT_PLATE_MIN_CONFIDENCE=0.3
# YOLO plate detector (scripts/train_tyre_plate_detector.py); its boxes are read before the
# OpenCV locator's. Unset or missing = OpenCV locator only.
# IRENT_PLATE_DETECTOR_WEIGHTS_PATH=./weights/tyre_plate.pt
IRENT_PLATE_DETECTOR_CONFIDENCE_THRESHOLD=0.25

# --- Tire detection ----------------------------------------------------
# One-class tire model or the tyre + plate model (only its tyre class is used).
# Unset or missing = startup error unless IRENT_TIRE_USE_MOCK=true (fake boxes).
# IRENT_TIRE_WEIGHTS_PATH=./weights/tyre_plate.pt
# IRENT_TIRE_USE_MOCK=true
IRENT_TIRE_CONFIDENCE_THRESHOLD=0.35

# --- Upload constraints -------------------------------------------------
IRENT_MAX_IMAGE_BYTES=10485760
# JSON array; must be valid JSON when set via env.
IRENT_ALLOWED_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

# --- HTTP --------------------------------------------------------------
IRENT_CORS_ALLOW_ORIGINS=["*"]

# --- iRent ops database --------------------------------------------------
# Link results to `vehicles` by plate; damage findings are written to damage_annotations,
# ai_anomaly_alerts and vehicles.latest_anomaly. Unset or missing = no DB access.
IRENT_DB_PATH=./data/irent_op_backend.sqlite
