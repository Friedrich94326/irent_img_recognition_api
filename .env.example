# Copy to .env and adjust. All variables are optional; defaults shown.

# --- App -------------------------------------------------------------------
IRENT_APP_NAME=iRent Car Damage Evaluation API
IRENT_VERSION=0.1.0

# --- Model / inference ---------------------------------------------------
# Path to a YOLOv8 .pt file. Leave unset to run with the built-in mock detector.
# IRENT_YOLO_WEIGHTS_PATH=./weights/car_damage.pt
IRENT_YOLO_CONFIDENCE_THRESHOLD=0.25
IRENT_YOLO_IOU_THRESHOLD=0.45
IRENT_YOLO_DEVICE=cpu

# --- Upload constraints -------------------------------------------------
IRENT_MAX_IMAGE_BYTES=10485760
# JSON array; must be valid JSON when set via env.
IRENT_ALLOWED_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

# --- HTTP --------------------------------------------------------------
IRENT_CORS_ALLOW_ORIGINS=["*"]
